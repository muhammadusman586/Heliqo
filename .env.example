# Contact form email delivery via Resend (https://resend.com)
# Copy this file to .env.local (git-ignored) and fill in the values.

RESEND_API_KEY=

# Where new project inquiries are delivered
CONTACT_TO_EMAIL=hello@heliqo.com

# Sender address — must be on a domain verified in Resend.
# For testing, onboarding@resend.dev works (it can only deliver to your own Resend account email).
CONTACT_FROM_EMAIL=Heliqo Website <onboarding@resend.dev>

# Calendly scheduling page shown under "Schedule a meeting" (e.g. https://calendly.com/heliqo/30min)
NEXT_PUBLIC_CALENDLY_URL=
